{
  "manifest_version": 3,
  "name": "DomainMeter",
  "version": "1.0.0",
  "description": "Billable time by site. Logs active-tab minutes and estimates revenue at your rate.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "action": { "default_popup": "popup.html", "default_title": "DomainMeter" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
